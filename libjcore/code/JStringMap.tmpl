// protected

template <class V>
bool
JStringMap<V>::Contains
	(
	const JString&              key,
	JStringMap<V>::ConstCursor& cursor
	)
	const
{
	// We know the hash value does not depend on V, so this is safe
	JStrValue<V> hashEntry;
	hashEntry.key = &key;
	cursor.ResetKey(hashEntry);
	return cursor.NextKey();
}

